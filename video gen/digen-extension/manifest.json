{
  "manifest_version": 3,
  "name": "Affilation Video Gen",
  "version": "1.2.0",
  "description": "Automates Digen AI and Google Flow with true native hardware events.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "debugger",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://digen.ai/*",
    "https://flow.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [{
    "resources": ["toy_car.jpg"],
    "matches": ["https://digen.ai/*", "https://flow.google.com/*"]
  }],
  "content_scripts": [
    {
      "matches": ["https://digen.ai/*", "https://flow.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
